  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.8",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^20.0.7",
    "@angular/router": "^22.1.3",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "angular-auth-oidc-client": "^17.0.0",
    "angularx-qrcode": "^22.0.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.21",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@types/jest": "^29.5.13",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.9.1",
    "jest": "^29.7.0",
    "jest-preset-angular": "^17.0.0",
    "json-server": "^1.0.0-beta.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.57.0"
